<UserControl x:Class="CineCore.Views.BookingConfirmationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#020617" Foreground="White" FontFamily="Segoe UI">

    <UserControl.Resources>
        <!-- Tombol aksi bawah ticket -->
        <Style x:Key="TicketActionBtn" TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="24,10"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Container ikon kecil 28x28 (cinema/date) -->
        <Style x:Key="IconChip" TargetType="Border">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Label kecil uppercase -->
        <Style x:Key="MiniLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="672" HorizontalAlignment="Center" Margin="24,40">

            <!-- ══════════ SECTION 1: SUCCESS HEADER ══════════ -->
            <StackPanel HorizontalAlignment="Center" Margin="0,0,0,32" Opacity="0">
                <StackPanel.RenderTransform>
                    <TranslateTransform Y="-16"/>
                </StackPanel.RenderTransform>
                <StackPanel.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1"
                                                 BeginTime="0:0:0.1" Duration="0:0:0.5"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 From="-16" To="0" BeginTime="0:0:0.1" Duration="0:0:0.5">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </StackPanel.Triggers>

                <Border Background="#1A22C55E" BorderBrush="#3322C55E" BorderThickness="1" CornerRadius="999"
                        Padding="20,8" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M5 12 L10 17 L19 8" Stroke="#4ADE80" StrokeThickness="2.5" Fill="Transparent"
                              Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center"/>
                        <TextBlock Text="Payment Successful" Foreground="#4ADE80" FontSize="14" FontWeight="SemiBold"
                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Your E-Ticket" FontSize="30" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Show this ticket at the cinema entrance" Foreground="#94A3B8" FontSize="14"
                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- ══════════ SECTION 2: TICKET CARD ══════════ -->
            <Border x:Name="TicketCard" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1"
                    CornerRadius="16" ClipToBounds="True" Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="45" ShadowDepth="0" Opacity="0.4"/>
                </Border.Effect>
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                </Border.RenderTransform>
                <Border.Triggers>
                    <EventTrigger RoutedEvent="Border.Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1"
                                                 BeginTime="0:0:0.3" Duration="0:0:0.7"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 From="0.95" To="1" BeginTime="0:0:0.3" Duration="0:0:0.7">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 From="0.95" To="1" BeginTime="0:0:0.3" Duration="0:0:0.7">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>

                <StackPanel>
                    <!-- ─── TOP: MOVIE INFO ─── -->
                    <Grid Margin="24,24,24,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Poster -->
                        <Border Grid.Column="0" Width="112" Height="160" CornerRadius="12" ClipToBounds="True"
                                BorderBrush="#80334155" BorderThickness="1" VerticalAlignment="Top">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="0" Opacity="0.35"/>
                            </Border.Effect>
                            <Grid>
                                <Border Background="#111827"/>
                                <Image Source="{Binding Movie.PosterUrl, Converter={StaticResource PosterUrl}}"
                                       Stretch="UniformToFill"/>
                            </Grid>
                        </Border>

                        <!-- Movie details -->
                        <StackPanel Grid.Column="1" Margin="20,4,0,4" VerticalAlignment="Top">
                            <TextBlock Text="{Binding Movie.Title}" FontSize="18" FontWeight="Bold" Foreground="White"
                                       TextTrimming="CharacterEllipsis"/>
                            <Border Background="#1A3B82F6" BorderBrush="#333B82F6" BorderThickness="1" CornerRadius="999"
                                    Padding="8,2" Margin="0,6,0,0" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding Format}" Foreground="#60A5FA" FontSize="12" FontWeight="Medium"/>
                            </Border>

                            <!-- Cinema info -->
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Border Style="{StaticResource IconChip}">
                                    <Path Data="M4 4 H20 V20 H4 Z M4 9 H20 M4 15 H20 M9 4 V20 M15 4 V20"
                                          Stroke="#3B82F6" StrokeThickness="2" Fill="Transparent"
                                          Width="14" Height="14" Stretch="Uniform"/>
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CinemaName}" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding CinemaType}" Foreground="#64748B" FontSize="12"
                                               Visibility="{Binding HasCinemaType, Converter={StaticResource BoolToVisibility}}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Date & time -->
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Border Style="{StaticResource IconChip}">
                                    <Path Data="M4 5 H20 V20 H4 Z M4 9 H20 M8 3 V6 M16 3 V6"
                                          Stroke="#3B82F6" StrokeThickness="2" Fill="Transparent"
                                          Width="14" Height="14" Stretch="Uniform"/>
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DateText}" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding TimeText}" Foreground="#60A5FA" FontSize="12" FontWeight="Bold"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- ─── PERFORATED DIVIDER ─── -->
                    <Grid Height="32">
                        <Line Stretch="Fill" X1="0" Y1="0" X2="1" Y2="0" Stroke="#99334155" StrokeThickness="2"
                              StrokeDashArray="4 3" Margin="32,0" VerticalAlignment="Center"/>
                        <Ellipse Width="32" Height="32" Fill="#020617" HorizontalAlignment="Left"
                                 VerticalAlignment="Center" Margin="-16,0,0,0"/>
                        <Ellipse Width="32" Height="32" Fill="#020617" HorizontalAlignment="Right"
                                 VerticalAlignment="Center" Margin="0,0,-16,0"/>
                    </Grid>

                    <!-- ─── BOTTOM: DETAILS + QR ─── -->
                    <Grid Margin="24,20,24,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Booking details -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <!-- Seats -->
                            <TextBlock Text="SEATS" Style="{StaticResource MiniLabel}" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding Seats}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#332563EB" BorderBrush="#4D3B82F6" BorderThickness="1"
                                                CornerRadius="8" Padding="12,6" Margin="0,0,6,6">
                                            <TextBlock Text="{Binding}" Foreground="#60A5FA" FontSize="12" FontWeight="Bold"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Booking reference -->
                            <TextBlock Text="BOOKING REFERENCE" Style="{StaticResource MiniLabel}" Margin="0,16,0,4"/>
                            <TextBlock Text="{Binding BookingCode}" Foreground="White" FontFamily="Consolas"
                                       FontWeight="Bold" FontSize="14"/>

                            <!-- Total paid -->
                            <TextBlock Text="TOTAL PAID" Style="{StaticResource MiniLabel}" Margin="0,16,0,4"/>
                            <TextBlock Text="{Binding TotalFormatted}" Foreground="#4ADE80" FontSize="18" FontWeight="Bold"/>

                            <!-- Status badge -->
                            <Border Background="#1A22C55E" BorderBrush="#3322C55E" BorderThickness="1" CornerRadius="999"
                                    Padding="12,4" HorizontalAlignment="Left" Margin="0,16,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M5 12 L10 17 L19 8" Stroke="#4ADE80" StrokeThickness="2.5" Fill="Transparent"
                                          Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"/>
                                    <TextBlock Text="Confirmed &amp; Paid" Foreground="#4ADE80" FontSize="12"
                                               FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- QR code -->
                        <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Border Background="White" CornerRadius="12" Padding="12">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="0" Opacity="0.3"/>
                                </Border.Effect>
                                <Image Width="160" Height="160"
                                       Source="{Binding QrImageUrl, Converter={StaticResource PosterUrl}}"/>
                            </Border>
                            <TextBlock Text="Scan at entrance" Foreground="#475569" FontSize="12"
                                       HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ══════════ SECTION 3: ACTION BUTTONS ══════════ -->
            <WrapPanel HorizontalAlignment="Center" Margin="0,26,0,0">
                <Button Style="{StaticResource TicketActionBtn}" Background="#16A34A" Click="DownloadPng_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M12 4 V15 M7 11 L12 16 L17 11 M5 19 H19" Stroke="White" StrokeThickness="2"
                              Fill="Transparent" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                        <TextBlock Text="Download PNG" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource TicketActionBtn}" Background="#9333EA" Click="DownloadJpg_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M12 4 V15 M7 11 L12 16 L17 11 M5 19 H19" Stroke="White" StrokeThickness="2"
                              Fill="Transparent" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                        <TextBlock Text="Download JPG" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource TicketActionBtn}" Background="#1E293B" BorderBrush="#334155"
                        BorderThickness="1" Foreground="#CBD5E1" Command="{Binding GoToMyTicketsCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M4 7 H20 V17 H4 Z M12 7 V9 M12 11 V13 M12 15 V17" Stroke="#CBD5E1" StrokeThickness="2"
                              Fill="Transparent" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                        <TextBlock Text="My Tickets" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource TicketActionBtn}" Background="#2563EB" Command="{Binding GoToHomeCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M4 11 L12 4 L20 11 M6 10 V20 H18 V10 M10 20 V14 H14 V20" Stroke="White" StrokeThickness="2"
                              Fill="Transparent" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                        <TextBlock Text="Back to Home" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </WrapPanel>

            <!-- ══════════ SECTION 4: FOOTER NOTE ══════════ -->
            <TextBlock Text="Please arrive at least 15 minutes before the showtime. This e-ticket is valid for one-time entry only."
                       Foreground="#475569" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                       MaxWidth="520" HorizontalAlignment="Center" Margin="0,24,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
