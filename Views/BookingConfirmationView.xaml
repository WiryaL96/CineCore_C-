<UserControl x:Class="CineCore.Views.BookingConfirmationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0A0B14" Foreground="White">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="500">
        <Border Background="#12141F" CornerRadius="16" Padding="40" BorderBrush="#1E2030" BorderThickness="1">
            <StackPanel HorizontalAlignment="Center">
                <!-- Success Icon -->
                <Border Width="80" Height="80" CornerRadius="40" Background="#1A3B82F6" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <TextBlock Text="✓" Foreground="#3B82F6" FontSize="40" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="Booking Confirmed!" FontSize="28" FontWeight="Bold" Foreground="#F0F2FF"
                           HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="Your tickets have been booked successfully" Foreground="#8B8FA8" FontSize="14"
                           HorizontalAlignment="Center" Margin="0,0,0,30"/>

                <!-- Booking Code -->
                <Border Background="#0D0F1E" CornerRadius="8" Padding="16" Margin="0,0,0,24">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="BOOKING CODE" Foreground="#8B8FA8" FontSize="11" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding BookingCode}" Foreground="#3B82F6" FontSize="24" FontWeight="Bold"
                                   HorizontalAlignment="Center" FontFamily="Consolas"/>
                    </StackPanel>
                </Border>

                <!-- Details -->
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="Movie" Foreground="#8B8FA8"/>
                    <TextBlock Text="{Binding Movie.Title}" HorizontalAlignment="Right" FontWeight="SemiBold" TextAlignment="Right"
                               MaxWidth="280" TextTrimming="CharacterEllipsis"/>
                </Grid>
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="Cinema" Foreground="#8B8FA8"/>
                    <TextBlock Text="{Binding Cinema.Name}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                </Grid>
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="Date" Foreground="#8B8FA8"/>
                    <TextBlock Text="{Binding Showtime.ShowDate, StringFormat={}{0:dd MMM yyyy}}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                </Grid>
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="Time" Foreground="#8B8FA8"/>
                    <TextBlock Text="{Binding Showtime.TimeFormatted}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                </Grid>
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="Seats" Foreground="#8B8FA8"/>
                    <TextBlock Text="{Binding SeatsText}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                </Grid>
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="Payment" Foreground="#8B8FA8"/>
                    <TextBlock Text="{Binding PaymentMethod}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                </Grid>

                <Separator Background="#1E2030" Margin="0,12"/>

                <Grid Margin="0,0,0,24">
                    <TextBlock Text="Total" Foreground="#F0F2FF" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalPrice, StringFormat=Rp {0:N0}}" Foreground="#3B82F6" FontSize="20" FontWeight="Bold" HorizontalAlignment="Right"/>
                </Grid>

                <Button Content="Back to Dashboard" Style="{StaticResource PrimaryButton}" Height="44"
                        Command="{Binding GoToDashboardCommand}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
