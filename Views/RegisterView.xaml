<UserControl x:Class="CineCore.Views.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CineCore.ViewModels"
             Background="#0A0B14">


    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="480"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="#0D0F1E" ClipToBounds="True">
            <Ellipse Width="600" Height="600" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#15004488" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="72" Height="72" CornerRadius="20" HorizontalAlignment="Center" Margin="0,0,0,24">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#007AFF" Offset="0"/>
                            <GradientStop Color="#0040CC" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="▶" Foreground="White" FontSize="30"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="C I N E C O R E" Foreground="White" FontSize="32" FontWeight="Bold"
                           FontFamily="Segoe UI" HorizontalAlignment="Center"/>
                <TextBlock Text="Join millions of movie lovers today."
                           Foreground="#5A6080" FontSize="13" FontFamily="Segoe UI"
                           HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Background="#0A0B14">
            <StackPanel Margin="48,48">

                <TextBlock Text="Create your account" Foreground="#F0F2FF"
                           FontSize="24" FontWeight="Bold" FontFamily="Segoe UI" Margin="0,0,0,4"/>
                <TextBlock Text="Start booking your cinema experience"
                           Foreground="#5A6080" FontSize="14" FontFamily="Segoe UI" Margin="0,0,0,32"/>

                <TextBlock Text="FULL NAME" Style="{StaticResource LabelText}"/>
                <TextBox Style="{StaticResource DarkTextBox}"
                         Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,18"/>

                <TextBlock Text="EMAIL ADDRESS" Style="{StaticResource LabelText}"/>
                <TextBox Style="{StaticResource DarkTextBox}"
                         Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,18"/>

                <TextBlock Text="PASSWORD" Style="{StaticResource LabelText}"/>
                <Grid Margin="0,0,0,18">
                    <PasswordBox x:Name="PwdBox" PasswordChanged="PasswordBox_Changed">
                        <PasswordBox.Style>
                            <Style TargetType="PasswordBox" BasedOn="{StaticResource DarkPasswordBox}">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowPassword}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </PasswordBox.Style>
                    </PasswordBox>

                    <TextBox Style="{StaticResource DarkTextBox}"
                             Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding ShowPassword, Converter={StaticResource BoolToVisibility}}"/>

                    <Button Command="{Binding TogglePasswordCommand}"
                            Background="Transparent" BorderThickness="0"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,12,0" Cursor="Hand" Width="28" Height="28">
                        <TextBlock Text="👁" FontSize="16" Foreground="#5A6080"/>
                    </Button>
                </Grid>

                <TextBlock Text="CONFIRM PASSWORD" Style="{StaticResource LabelText}"/>
                <Grid Margin="0,0,0,6">
                    <PasswordBox x:Name="ConfirmPwdBox" PasswordChanged="ConfirmPasswordBox_Changed">
                        <PasswordBox.Style>
                            <Style TargetType="PasswordBox" BasedOn="{StaticResource DarkPasswordBox}">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowPassword}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </PasswordBox.Style>
                    </PasswordBox>

                    <TextBox Style="{StaticResource DarkTextBox}"
                             Text="{Binding ConfirmPassword, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding ShowPassword, Converter={StaticResource BoolToVisibility}}"/>
                </Grid>

                <TextBlock Text="{Binding ErrorMessage}" Margin="0,4,0,12">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource ErrorText}">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Button Content="CREATE ACCOUNT"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding RegisterCommand}"
                        Margin="0,12,0,0"/>

                <ProgressBar IsIndeterminate="True" Height="2" Margin="0,8,0,0"
                             Background="Transparent" Foreground="#007AFF" BorderThickness="0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,28,0,0">
                    <TextBlock Text="Already have an account? " Foreground="#5A6080"
                               FontSize="14" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                    <Button Content="Sign in" Style="{StaticResource GhostButton}"
                            Command="{Binding GoToLoginCommand}" FontSize="14"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>