<UserControl x:Class="CineCore.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0A0B14">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0D0F1E" BorderBrush="#1E2030" BorderThickness="0,0,0,1" Panel.ZIndex="10">
            <Grid Margin="32,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="▶" Foreground="#007AFF" FontSize="24" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="C I N E C O R E" Foreground="White" FontSize="20" FontWeight="Bold" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                </StackPanel>

                <Border Grid.Column="1" Background="#1A1C2A" CornerRadius="8" Width="400" Height="40" HorizontalAlignment="Center" BorderBrush="#252736" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Margin="12,0">
                        <TextBlock Text="🔍" Foreground="#5A6080" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Background="Transparent" BorderThickness="0" Foreground="White" VerticalAlignment="Center" Width="340"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" FontSize="13" FontFamily="Segoe UI"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="My Bookings" Style="{StaticResource GhostButton}" Margin="0,0,16,0"
                            Command="{Binding ViewHistoryCommand}" FontSize="13"/>
                    <TextBlock Text="{Binding WelcomeText}" Foreground="#F0F2FF" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <Button Content="Logout" Style="{StaticResource SecondaryButton}" Height="36" Padding="20,0"
                            Command="{Binding LogoutCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,64">

                <Grid Height="450">
                    <Image Source="https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?q=80&amp;w=2070" Stretch="UniformToFill" Opacity="0.5"/>
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#44000000" Offset="0"/>
                                <GradientStop Color="#0A0B14" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <StackPanel VerticalAlignment="Center" Margin="48,0" HorizontalAlignment="Left">
                        <Border Background="#1A007AFF" HorizontalAlignment="Left" Padding="12,6" CornerRadius="16" Margin="0,0,0,16">
                            <TextBlock Text="Now Showing" Foreground="#007AFF" FontWeight="Bold" FontSize="12"/>
                        </Border>
                        <TextBlock Text="Experience Cinema" FontSize="56" FontWeight="Bold" Foreground="White" FontFamily="Segoe UI"/>
                        <TextBlock Text="Like Never Before" FontSize="56" FontWeight="Bold" Foreground="White" FontFamily="Segoe UI" Margin="0,-10,0,16"/>
                        <TextBlock Text="Book your ticket instantly. Choose your seats. Enjoy the latest blockbuster in&#x0a;premium comfort." 
                                   Foreground="#C0C4D6" FontSize="15" LineHeight="24" Margin="0,0,0,32"/>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Browse Movies →" Style="{StaticResource PrimaryButton}" Height="44" Padding="24,0" Margin="0,0,16,0"
                                    Command="{Binding BrowseMoviesCommand}"/>
                            <Button Content="Find Cinemas" Style="{StaticResource SecondaryButton}" Height="44" Padding="24,0"
                                    Command="{Binding FindCinemasCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Now Showing" FontSize="28" FontWeight="Bold" Foreground="White" Margin="48,24,48,20" FontFamily="Segoe UI"/>
                <ItemsControl ItemsSource="{Binding NowShowingMovies}" Margin="48,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="220" Margin="0,0,24,32" Background="#12141F" CornerRadius="12" BorderBrush="#1E2030" BorderThickness="1" ClipToBounds="True">
                                <StackPanel>
                                    <Grid Height="320">
                                        <Border Background="#1A1C2A">
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Text="🎬" FontSize="40" HorizontalAlignment="Center" Opacity="0.5"/>
                                                <TextBlock Text="No Poster" Foreground="#5A6080" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Image Source="{Binding PosterUrl, Converter={StaticResource PosterUrl}}" Stretch="UniformToFill"/>
                                    </Grid>

                                    <StackPanel Margin="16">
                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="White" FontSize="16" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Genre}" Foreground="#8B8FA8" FontSize="12" Margin="0,4,0,16"/>

                                        <Button Content="Buy Ticket" Style="{StaticResource PrimaryButton}" Height="38"
                                                Command="{Binding DataContext.BuyTicketCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Coming Soon" FontSize="28" FontWeight="Bold" Foreground="White" Margin="48,24,48,20" FontFamily="Segoe UI"/>
                <ItemsControl ItemsSource="{Binding ComingSoonMovies}" Margin="48,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="220" Margin="0,0,24,32" Background="#12141F" CornerRadius="12" BorderBrush="#1E2030" BorderThickness="1" ClipToBounds="True">
                                <StackPanel>
                                    <Grid Height="320">
                                        <Border Background="#1A1C2A">
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Text="🎬" FontSize="40" HorizontalAlignment="Center" Opacity="0.5"/>
                                                <TextBlock Text="No Poster" Foreground="#5A6080" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Image Source="{Binding PosterUrl, Converter={StaticResource PosterUrl}}" Stretch="UniformToFill" Opacity="0.8"/>
                                    </Grid>

                                    <StackPanel Margin="16">
                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="White" FontSize="16" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Genre}" Foreground="#8B8FA8" FontSize="12" Margin="0,4,0,16"/>
                                        <TextBlock Text="{Binding ReleaseDate, StringFormat='{}{0:MMM dd, yyyy}'}"
                                                   Foreground="#007AFF" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ProgressBar IsIndeterminate="True" Height="4" Width="200" Background="Transparent" Foreground="#007AFF" BorderThickness="0"
                             Margin="0,40,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>