<UserControl x:Class="CineCore.Views.AdminPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             Background="#0F172A" Foreground="White" FontFamily="Segoe UI">

    <UserControl.Resources>

        <!-- Sidebar nav item -->
        <Style x:Key="NavItem" TargetType="Button">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="12" Padding="12,10">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#801E293B"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <!-- ACTIVE: dikontrol lewat Tag (bind ke IsMoviesSection/IsReportSection) -->
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}">
                                <DataTrigger.Value>
                                    <sys:Boolean>True</sys:Boolean>
                                </DataTrigger.Value>
                                <Setter TargetName="bd" Property="Background" Value="#1A2563EB"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#332563EB"/>
                                <Setter Property="Foreground" Value="#60A5FA"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Stat card -->
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="#801E293B"/>
            <Setter Property="BorderBrush" Value="#66334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <!-- Section card -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#4D1E293B"/>
            <Setter Property="BorderBrush" Value="#66334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="24"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Icon action button (edit/delete) -->
        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1E293B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Progress bars -->
        <Style x:Key="BarPurple" TargetType="ProgressBar">
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="#4D334155" CornerRadius="999"/>
                            <Border x:Name="PART_Track"/>
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="999">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#9333EA" Offset="0"/>
                                        <GradientStop Color="#C084FC" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BarBlue" TargetType="ProgressBar">
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="#4D334155" CornerRadius="8"/>
                            <Border x:Name="PART_Track"/>
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="8">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#2563EB" Offset="0"/>
                                        <GradientStop Color="#60A5FA" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="256"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════ SIDEBAR ══════════ -->
        <Border Grid.Column="0" Background="#0B1120" BorderBrush="#99334155" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Logo -->
                <Border DockPanel.Dock="Top" Height="64" BorderBrush="#99334155" BorderThickness="0,0,0,1" Padding="24,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="32" Height="32" CornerRadius="8">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#2563EB" Offset="0"/>
                                    <GradientStop Color="#9333EA" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="C" Foreground="White" FontWeight="Bold" FontSize="16"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock>
                                <Run Text="Cine" Foreground="#60A5FA" FontWeight="Bold" FontSize="15"/><Run Text="Core" Foreground="#C084FC" FontWeight="Bold" FontSize="15"/>
                            </TextBlock>
                            <TextBlock Text="ADMIN PANEL" Foreground="#64748B" FontSize="9"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Nav -->
                <StackPanel DockPanel.Dock="Top" Margin="16,24">
                    <TextBlock Text="MAIN MENU" Foreground="#475569" FontSize="10" FontWeight="SemiBold" Margin="12,0,0,10"/>

                    <Button Style="{StaticResource NavItem}" Command="{Binding GoToDashboardCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M4 4 H10 V10 H4 Z M14 4 H20 V10 H14 Z M4 14 H10 V20 H4 Z M14 14 H20 V20 H14 Z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="2" Fill="Transparent" Width="18" Height="18" Stretch="Uniform"/>
                            <TextBlock Text="Dashboard" Margin="12,0,0,0" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavItem}" Command="{Binding ShowMoviesCommand}" Tag="{Binding IsMoviesSection}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M4 4 H20 V20 H4 Z M4 9 H20 M4 15 H20 M9 4 V20 M15 4 V20"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="2" Fill="Transparent" Width="18" Height="18" Stretch="Uniform"/>
                            <TextBlock Text="Movies" Margin="12,0,0,0" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavItem}" Command="{Binding ShowReportCommand}" Tag="{Binding IsReportSection}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M4 20 H21 M5 20 V11 M10 20 V5 M15 20 V13 M20 20 V8"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="2" Fill="Transparent" Width="18" Height="18" Stretch="Uniform"/>
                            <TextBlock Text="Sales &amp; Report" Margin="12,0,0,0" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavItem}" Command="{Binding ShowActivityCommand}" Tag="{Binding IsActivitySection}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M12 21 A9 9 0 1 0 12 3 A9 9 0 1 0 12 21 M12 7 V12 L15.5 14"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="2" Fill="Transparent" Width="18" Height="18" Stretch="Uniform"/>
                            <TextBlock Text="Log Activities" Margin="12,0,0,0" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ══════════ MAIN AREA ══════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Border Grid.Row="0" Background="#CC0B1120" BorderBrush="#99334155" BorderThickness="0,0,0,1">
                <Grid Margin="32,0">
                    <!-- Search -->
                    <Border HorizontalAlignment="Left" Width="380" Height="38" Background="#801E293B"
                            BorderBrush="#80334155" BorderThickness="1" CornerRadius="10" VerticalAlignment="Center">
                        <Grid Margin="12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Width="16" Height="16" VerticalAlignment="Center">
                                <Ellipse Width="12" Height="12" Stroke="#64748B" StrokeThickness="1.6"
                                         HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                <Line X1="11" Y1="11" X2="15" Y2="15" Stroke="#64748B" StrokeThickness="1.6"/>
                            </Grid>
                            <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0" Foreground="White"
                                     VerticalContentAlignment="Center" Margin="8,0,0,0" FontSize="14"
                                     CaretBrush="#60A5FA"/>
                        </Grid>
                    </Border>

                    <!-- Actions -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Grid Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center">
                            <Path Data="M7 16 L7 10 Q7 5 12 5 Q17 5 17 10 L17 16 L19 18 H5 Z M10 18 H14"
                                  Stroke="#94A3B8" StrokeThickness="1.6" Fill="Transparent" Stretch="Uniform"/>
                            <Ellipse Width="7" Height="7" Fill="#3B82F6" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-1,-1,0"/>
                        </Grid>
                        <Border Width="1" Height="28" Background="#334155" Margin="0,0,16,0"/>

                        <ToggleButton x:Name="ProfileToggle" Background="Transparent" BorderThickness="0" Cursor="Hand">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="{TemplateBinding Background}" Padding="4" CornerRadius="8">
                                        <ContentPresenter/>
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="32" Height="32" CornerRadius="8">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#2563EB" Offset="0"/>
                                            <GradientStop Color="#9333EA" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <TextBlock Text="{Binding CurrentUserInitial}" Foreground="White" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="10,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CurrentUserName}" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="Administrator" Foreground="#64748B" FontSize="11"/>
                                </StackPanel>
                                <TextBlock Text="▾" Foreground="#64748B" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>

                        <Popup IsOpen="{Binding IsChecked, ElementName=ProfileToggle}" PlacementTarget="{Binding ElementName=ProfileToggle}"
                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True" HorizontalOffset="-40" VerticalOffset="6">
                            <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="12" Width="240" Padding="6">
                                <StackPanel>
                                    <StackPanel Margin="10,8">
                                        <TextBlock Text="{Binding CurrentUserName}" Foreground="White" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding CurrentUserEmail}" Foreground="#64748B" FontSize="12"/>
                                    </StackPanel>
                                    <Border Height="1" Background="#1E293B" Margin="0,4"/>
                                    <Button Content="View Public Site" Command="{Binding GoToDashboardCommand}"
                                            HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0"
                                            Foreground="#CBD5E1" Padding="10,8" Cursor="Hand"/>
                                    <Button Content="Logout" Command="{Binding LogoutCommand}"
                                            HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0"
                                            Foreground="#F87171" Padding="10,8" Cursor="Hand"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="32">

                    <!-- Flash message -->
                    <Border Background="#1A10B981" BorderBrush="#4D10B981" BorderThickness="1" CornerRadius="10"
                            Padding="16,10" Margin="0,0,0,20"
                            Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding StatusMessage}" Foreground="#34D399" FontSize="13" FontWeight="SemiBold"/>
                    </Border>

                    <!-- ═══════════ MOVIES SECTION ═══════════ -->
                    <Grid Visibility="{Binding IsMoviesSection, Converter={StaticResource BoolToVisibility}}">

                        <!-- ===== MOVIE LIST ===== -->
                        <StackPanel Visibility="{Binding IsListView, Converter={StaticResource BoolToVisibility}}">
                            <!-- Stats -->
                            <Grid Margin="0,0,0,32">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource StatCard}">
                                    <StackPanel>
                                        <Grid>
                                            <Border Width="48" Height="48" CornerRadius="12" Background="#1A3B82F6" HorizontalAlignment="Left">
                                                <Path Data="M4 4 H20 V20 H4 Z M4 9 H20 M4 15 H20 M9 4 V20 M15 4 V20"
                                                      Stroke="#60A5FA" StrokeThickness="2" Fill="Transparent" Width="22" Height="22" Stretch="Uniform"/>
                                            </Border>
                                            <Border Background="#1E293B" CornerRadius="999" Padding="8,3" HorizontalAlignment="Right" VerticalAlignment="Top">
                                                <TextBlock Text="All Time" Foreground="#64748B" FontSize="11"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding TotalMovies}" FontSize="30" FontWeight="Bold" Foreground="White" Margin="0,14,0,0"/>
                                        <TextBlock Text="Total Movies" Foreground="#64748B" FontSize="14"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource StatCard}">
                                    <StackPanel>
                                        <Grid>
                                            <Border Width="48" Height="48" CornerRadius="12" Background="#1A10B981" HorizontalAlignment="Left">
                                                <Path Data="M12 3 A9 9 0 1 0 12.01 3 Z M10 8 L16 12 L10 16 Z"
                                                      Stroke="#34D399" StrokeThickness="2" Fill="Transparent" Width="22" Height="22" Stretch="Uniform"/>
                                            </Border>
                                            <Border Background="#1A10B981" BorderBrush="#3310B981" BorderThickness="1" CornerRadius="999" Padding="8,3" HorizontalAlignment="Right" VerticalAlignment="Top">
                                                <TextBlock Text="Active" Foreground="#34D399" FontSize="11"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding NowShowingCount}" FontSize="30" FontWeight="Bold" Foreground="White" Margin="0,14,0,0"/>
                                        <TextBlock Text="Now Showing" Foreground="#64748B" FontSize="14"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="4" Style="{StaticResource StatCard}">
                                    <StackPanel>
                                        <Grid>
                                            <Border Width="48" Height="48" CornerRadius="12" Background="#1AF59E0B" HorizontalAlignment="Left">
                                                <Path Data="M12 3 A9 9 0 1 0 12.01 3 Z M12 7 V12 L15.5 13.5"
                                                      Stroke="#FBBF24" StrokeThickness="2" Fill="Transparent" Width="22" Height="22" Stretch="Uniform"/>
                                            </Border>
                                            <Border Background="#1AF59E0B" BorderBrush="#33F59E0B" BorderThickness="1" CornerRadius="999" Padding="8,3" HorizontalAlignment="Right" VerticalAlignment="Top">
                                                <TextBlock Text="Upcoming" Foreground="#FBBF24" FontSize="11"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding ComingSoonCount}" FontSize="30" FontWeight="Bold" Foreground="White" Margin="0,14,0,0"/>
                                        <TextBlock Text="Coming Soon" Foreground="#64748B" FontSize="14"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Header row -->
                            <Grid Margin="0,0,0,24">
                                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="Movie Catalog" FontSize="24" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="Manage your entire movie library" Foreground="#64748B" FontSize="14" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Command="{Binding AddNewMovieCommand}"
                                        Cursor="Hand" Foreground="White" FontWeight="SemiBold">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="#2563EB" CornerRadius="10" Padding="18,10">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="M12 5 V19 M5 12 H19" Stroke="White" StrokeThickness="2" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Add Movie" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#3B82F6"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>

                            <!-- Movies table -->
                            <Border Background="#4D1E293B" BorderBrush="#66334155" BorderThickness="1" CornerRadius="16">
                                <StackPanel>
                                    <!-- header -->
                                    <Grid Margin="20,16" >
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="POSTER" Foreground="#64748B" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Text="TITLE" Foreground="#64748B" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="2" Text="GENRE" Foreground="#64748B" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="3" Text="DURATION" Foreground="#64748B" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="4" Text="STATUS" Foreground="#64748B" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="5" Text="ACTIONS" Foreground="#64748B" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Border Height="1" Background="#66334155"/>

                                    <!-- empty -->
                                    <StackPanel Margin="0,64" HorizontalAlignment="Center"
                                                Visibility="{Binding MoviesEmpty, Converter={StaticResource BoolToVisibility}}">
                                        <Path Data="M4 4 H20 V20 H4 Z M4 9 H20 M4 15 H20 M9 4 V20 M15 4 V20"
                                              Stroke="#334155" StrokeThickness="1.5" Fill="Transparent" Width="48" Height="48" Stretch="Uniform" HorizontalAlignment="Center"/>
                                        <TextBlock Text="No movies found" Foreground="#64748B" FontWeight="Medium" HorizontalAlignment="Center" Margin="0,16,0,4"/>
                                        <TextBlock Text="Create your first movie to get started." Foreground="#475569" FontSize="12" HorizontalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- rows -->
                                    <ItemsControl ItemsSource="{Binding Movies}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#33334155" BorderThickness="0,0,0,1" Padding="20,14">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="70"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="120"/>
                                                            <ColumnDefinition Width="90"/>
                                                            <ColumnDefinition Width="150"/>
                                                            <ColumnDefinition Width="100"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- poster -->
                                                        <Border Grid.Column="0" Width="48" Height="64" CornerRadius="8" ClipToBounds="True"
                                                                HorizontalAlignment="Left" BorderBrush="#80334155" BorderThickness="1">
                                                            <Grid>
                                                                <Border Background="#334155"/>
                                                                <Image Source="{Binding PosterUrl, Converter={StaticResource PosterUrl}}" Stretch="UniformToFill"/>
                                                            </Grid>
                                                        </Border>

                                                        <!-- title -->
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                            <TextBlock Text="{Binding Title}" Foreground="White" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Description}" Foreground="#64748B" FontSize="12" MaxWidth="360"
                                                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                            <TextBlock Foreground="#475569" FontSize="11" Margin="0,2,0,0">
                                                                <Run Text="{Binding Format, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding ReleaseDate, StringFormat={}{0:dd MMM yyyy}, Mode=OneWay}"/>
                                                            </TextBlock>
                                                        </StackPanel>

                                                        <!-- genre -->
                                                        <Border Grid.Column="2" Background="#80334155" BorderBrush="#4D475569" BorderThickness="1" CornerRadius="6"
                                                                Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Genre}" Foreground="#CBD5E1" FontSize="12"/>
                                                        </Border>

                                                        <!-- duration -->
                                                        <TextBlock Grid.Column="3" Text="{Binding DurationMinutes, StringFormat={}{0} min}" Foreground="#CBD5E1" FontSize="14" VerticalAlignment="Center"/>

                                                        <!-- status -->
                                                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Border Background="#1A10B981" BorderBrush="#3310B981" BorderThickness="1" CornerRadius="999" Padding="8,3"
                                                                    Visibility="{Binding IsShowing, Converter={StaticResource BoolToVisibility}}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Ellipse Width="7" Height="7" Fill="#34D399" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="Now Showing" Foreground="#34D399" FontSize="11" Margin="6,0,0,0"/>
                                                                </StackPanel>
                                                            </Border>
                                                            <Border Background="#1AF59E0B" BorderBrush="#33F59E0B" BorderThickness="1" CornerRadius="999" Padding="8,3"
                                                                    Visibility="{Binding IsShowing, Converter={StaticResource InverseBoolToVisibility}}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Ellipse Width="7" Height="7" Fill="#FBBF24" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="Coming Soon" Foreground="#FBBF24" FontSize="11" Margin="6,0,0,0"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>

                                                        <!-- actions -->
                                                        <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                            <Button Style="{StaticResource IconBtn}"
                                                                    Command="{Binding DataContext.EditMovieCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}" ToolTip="Edit">
                                                                <Path Data="M4 20 H8 L18 10 L14 6 L4 16 Z M13 7 L17 11" Stroke="#60A5FA" StrokeThickness="1.6" Fill="Transparent" Width="16" Height="16" Stretch="Uniform"/>
                                                            </Button>
                                                            <Button Style="{StaticResource IconBtn}"
                                                                    Command="{Binding DataContext.DeleteMovieCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}" ToolTip="Delete">
                                                                <Path Data="M5 7 H19 M9 7 V5 H15 V7 M7 7 L8 20 H16 L17 7" Stroke="#F87171" StrokeThickness="1.6" Fill="Transparent" Width="16" Height="16" Stretch="Uniform"/>
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ===== MOVIE FORM (create/edit) ===== -->
                        <StackPanel Visibility="{Binding IsEditingMovie, Converter={StaticResource BoolToVisibility}}">
                            <Button Content="← Back to Movies" Command="{Binding CancelEditCommand}"
                                    Background="Transparent" Foreground="#94A3B8" BorderThickness="0"
                                    HorizontalAlignment="Left" FontSize="14" Cursor="Hand" Margin="0,0,0,12"/>
                            <TextBlock Text="{Binding FormTitle}" FontSize="24" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="{Binding FormSubtitle}" Foreground="#64748B" FontSize="14" Margin="0,2,0,20"/>

                            <!-- validation -->
                            <Border Background="#1AEF4444" BorderBrush="#4DEF4444" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,20"
                                    Visibility="{Binding HasValidationErrors, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="⚠ Please fix the following errors:" Foreground="#F87171" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <ItemsControl ItemsSource="{Binding ValidationErrors}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Foreground="#F87171" FontSize="12" Margin="0,1"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <!-- LEFT -->
                                <StackPanel Grid.Column="0">
                                    <!-- Movie Information -->
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                                        <StackPanel>
                                            <TextBlock Text="Movie Information" Foreground="#60A5FA" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,16"/>
                                            <TextBlock Text="Title *" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>
                                            <TextBlock Text="Description" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding EditDescription, UpdateSourceTrigger=PropertyChanged}"
                                                     Height="90" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="12,8" Margin="0,0,0,14"/>
                                            <Grid Margin="0,0,0,14">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Genre *" Style="{StaticResource FieldLabel}"/>
                                                    <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding EditGenre, UpdateSourceTrigger=PropertyChanged}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Duration (min) *" Style="{StaticResource FieldLabel}"/>
                                                    <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding EditDuration, UpdateSourceTrigger=PropertyChanged}"/>
                                                </StackPanel>
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Format *" Style="{StaticResource FieldLabel}"/>
                                                    <ComboBox Style="{StaticResource DarkComboBox}" ItemsSource="{Binding FormatOptions}" SelectedItem="{Binding EditFormat}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Trailer URL" Style="{StaticResource FieldLabel}"/>
                                                    <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding EditTrailerUrl, UpdateSourceTrigger=PropertyChanged}"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Screening Details -->
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                                        <StackPanel>
                                            <TextBlock Text="Screening Details" Foreground="#C084FC" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,16"/>
                                            <Grid Margin="0,0,0,14">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Release Date *" Style="{StaticResource FieldLabel}"/>
                                                    <DatePicker SelectedDate="{Binding EditReleaseDate}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="End Date" Style="{StaticResource FieldLabel}"/>
                                                    <DatePicker SelectedDate="{Binding EditEndDate}"/>
                                                    <TextBlock Text="Defaults to 7 days after release if empty" Foreground="#475569" FontSize="11" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="Status *" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox Style="{StaticResource DarkComboBox}" SelectedIndex="{Binding EditStatusIndex}">
                                                <ComboBoxItem Content="🟢 Now Showing"/>
                                                <ComboBoxItem Content="🟡 Coming Soon"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Border>

                                    <!-- Showtime Generator -->
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="Showtime Generator" Foreground="#34D399" FontSize="15" FontWeight="SemiBold"/>
                                            <TextBlock Text="Auto-generate showtimes across cinemas and dates" Foreground="#64748B" FontSize="12" Margin="0,2,0,16"/>

                                            <TextBlock Text="Select Cinemas" Style="{StaticResource FieldLabel}"/>
                                            <ItemsControl ItemsSource="{Binding GeneratorCinemas}" Margin="0,0,0,14">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Display}" Foreground="#CBD5E1"
                                                                  Margin="0,4" VerticalContentAlignment="Center"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <TextBlock Text="Daily Showtime Hours (comma-separated)" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding GeneratorHours, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>
                                            <TextBlock Text="Showtimes will be generated for every day from release to end date." Foreground="#475569" FontSize="11" Margin="0,0,0,14"/>

                                            <TextBlock Text="Ticket Price" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding GeneratorPrice, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- RIGHT: poster -->
                                <StackPanel Grid.Column="2">
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="Movie Poster" Foreground="#FBBF24" FontSize="15" FontWeight="SemiBold"/>
                                            <TextBlock Text="Upload a poster image (JPG, PNG, WebP)" Foreground="#64748B" FontSize="12" Margin="0,2,0,16"/>

                                            <Border Height="300" CornerRadius="12" ClipToBounds="True" Margin="0,0,0,14">
                                                <Grid>
                                                    <Border BorderBrush="#80475569" BorderThickness="1" CornerRadius="12" Background="#33334155"
                                                            Visibility="{Binding HasPoster, Converter={StaticResource InverseBoolToVisibility}}">
                                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                            <TextBlock Text="🖼" FontSize="40" HorizontalAlignment="Center" Opacity="0.4"/>
                                                            <TextBlock Text="No poster uploaded" Foreground="#64748B" FontSize="12" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Image Source="{Binding EditPosterUrl, Converter={StaticResource PosterUrl}}" Stretch="UniformToFill"
                                                           Visibility="{Binding HasPoster, Converter={StaticResource BoolToVisibility}}"/>
                                                </Grid>
                                            </Border>

                                            <Button Content="Choose File" Command="{Binding ChoosePosterCommand}" Style="{StaticResource SecondaryButton}"
                                                    Height="40" Margin="0,0,0,10"/>
                                            <Button Content="{Binding SaveButtonText}" Command="{Binding SaveMovieCommand}" Style="{StaticResource PrimaryButton}"
                                                    Height="44" Margin="0,0,0,8"/>
                                            <Button Content="Cancel" Command="{Binding CancelEditCommand}" Style="{StaticResource GhostButton}" Height="30"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- ═══════════ REPORT SECTION ═══════════ -->
                    <StackPanel Visibility="{Binding IsReportSection, Converter={StaticResource BoolToVisibility}}">

                        <!-- Header -->
                        <Grid Margin="0,0,0,24">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Border Width="40" Height="40" CornerRadius="12">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#10B981" Offset="0"/>
                                            <GradientStop Color="#14B8A6" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Path Data="M4 20 H21 M5 20 V11 M10 20 V5 M15 20 V13 M20 20 V8" Stroke="White" StrokeThickness="2" Fill="Transparent" Width="20" Height="20" Stretch="Uniform"/>
                                </Border>
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Sales &amp; Report" FontSize="24" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="Overview of your ticket sales and revenue" Foreground="#94A3B8" FontSize="14"/>
                                </StackPanel>
                            </StackPanel>

                            <Button x:Name="ExportPdfButton" HorizontalAlignment="Right" VerticalAlignment="Center" Command="{Binding ShowPreviewCommand}"
                                    Cursor="Hand" Foreground="#F87171" FontWeight="SemiBold">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="#1AEF4444" BorderBrush="#4DEF4444" BorderThickness="1" CornerRadius="10" Padding="16,10">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="M7 3 H14 L19 8 V21 H7 Z M14 3 V8 H19 M9 13 H15 M9 16 H15" Stroke="#F87171" StrokeThickness="1.6" Fill="Transparent" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                                                <TextBlock Text="Export PDF" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#33EF4444"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- Filter Bar -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="FILTER DATA" Foreground="#60A5FA" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                    <Border Background="#1A10B981" BorderBrush="#3310B981" BorderThickness="1" CornerRadius="999" Padding="12,4"
                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Visibility="{Binding HasFilterStatus, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{Binding FilterStatusText}" Foreground="#34D399" FontSize="12" FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="Date Range" Foreground="#94A3B8" FontSize="13" VerticalAlignment="Center"/>
                                    <DatePicker Grid.Column="2" SelectedDate="{Binding FilterDateFrom}"
                                                DisplayDateEnd="{Binding FilterDateTo}" FontSize="12"/>
                                    <TextBlock Grid.Column="3" Text="  —  " Foreground="#64748B" VerticalAlignment="Center"/>
                                    <DatePicker Grid.Column="4" SelectedDate="{Binding FilterDateTo}"
                                                DisplayDateStart="{Binding FilterDateFrom}" FontSize="12"/>

                                    <Button Grid.Column="6" Command="{Binding ApplyFilterCommand}" Cursor="Hand" Foreground="White" FontWeight="SemiBold">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="#2563EB" CornerRadius="8" Padding="18,8">
                                                    <TextBlock Text="Apply Filter" FontSize="12" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#3B82F6"/></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button Grid.Column="8" Command="{Binding ResetFilterCommand}" Cursor="Hand" Foreground="#94A3B8">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="#801E293B" BorderBrush="#80334155" BorderThickness="1" CornerRadius="8" Padding="18,8">
                                                    <TextBlock Text="Reset" FontSize="12" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#1E293B"/></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Stat row 1 -->
                        <UniformGrid Columns="4" Margin="0,0,0,16">
                            <Border Style="{StaticResource StatCard}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="TOTAL REVENUE" Foreground="#64748B" FontSize="12"/>
                                    <TextBlock Text="{Binding TotalRevenueText}" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,8,0,4"/>
                                    <TextBlock Text="All paid transactions" Foreground="#34D399" FontSize="12"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatCard}" Margin="8,0">
                                <StackPanel>
                                    <TextBlock Text="TICKETS SOLD" Foreground="#64748B" FontSize="12"/>
                                    <TextBlock Text="{Binding TicketsSoldText}" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,8,0,4"/>
                                    <TextBlock Text="{Binding TicketsSoldSub}" Foreground="#60A5FA" FontSize="12"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatCard}" Margin="8,0">
                                <StackPanel>
                                    <TextBlock Text="AVERAGE TICKET PRICE" Foreground="#64748B" FontSize="12"/>
                                    <TextBlock Text="{Binding AvgTicketPriceText}" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,8,0,4"/>
                                    <TextBlock Text="Per ticket average" Foreground="#C084FC" FontSize="12"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatCard}" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="ACTIVE MOVIES" Foreground="#64748B" FontSize="12"/>
                                    <TextBlock Text="{Binding ActiveMoviesText}" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,8,0,4"/>
                                    <TextBlock Text="Currently showing" Foreground="#FBBF24" FontSize="12"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Stat row 2 -->
                        <UniformGrid Columns="4" Margin="0,0,0,20">
                            <Border Style="{StaticResource StatCard}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="REVENUE TODAY" Foreground="#64748B" FontSize="12"/>
                                    <TextBlock Text="{Binding RevenueTodayText}" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,8,0,4"/>
                                    <TextBlock Text="{Binding RevenueTodaySub}" Foreground="#64748B" FontSize="12"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatCard}" Margin="8,0">
                                <StackPanel>
                                    <TextBlock Text="REVENUE THIS MONTH" Foreground="#64748B" FontSize="12"/>
                                    <TextBlock Text="{Binding RevenueMonthText}" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,8,0,4"/>
                                    <TextBlock Text="{Binding RevenueMonthSub}" Foreground="#64748B" FontSize="12"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatCard}" Margin="8,0">
                                <StackPanel>
                                    <TextBlock Text="POTENTIAL REVENUE" Foreground="#64748B" FontSize="12"/>
                                    <TextBlock Text="{Binding PendingRevenueText}" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,8,0,4"/>
                                    <TextBlock Text="{Binding PendingSub}" Foreground="#FBBF24" FontSize="12"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatCard}" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="PAID CONVERSION" Foreground="#64748B" FontSize="12"/>
                                    <TextBlock Text="{Binding ConversionText}" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,8,0,4"/>
                                    <TextBlock Text="{Binding ConversionSub}" Foreground="#64748B" FontSize="12"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Revenue by cinema type + Top movies -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="REVENUE BY CINEMA" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,0,0,16"/>
                                    <ItemsControl ItemsSource="{Binding CinemaTypeRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,14">
                                                    <Grid Margin="0,0,0,6">
                                                        <TextBlock Text="{Binding Type}" Foreground="#CBD5E1" FontSize="14" FontWeight="Medium" HorizontalAlignment="Left"/>
                                                        <TextBlock Text="{Binding RevenueText}" Foreground="#CBD5E1" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                    <ProgressBar Style="{StaticResource BarPurple}" Height="10" Maximum="{Binding Max, Mode=OneWay}" Value="{Binding Value, Mode=OneWay}"/>
                                                    <TextBlock Text="{Binding BookingsText}" Foreground="#64748B" FontSize="11" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="TOP PERFORMING MOVIES (BY REVENUE)" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,0,0,16"/>
                                    <ItemsControl ItemsSource="{Binding TopMovieRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="150"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="120"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Title}" Foreground="#CBD5E1" FontSize="14" FontWeight="Medium"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                                                    <ProgressBar Grid.Column="1" Style="{StaticResource BarBlue}" Height="28" Maximum="{Binding Max, Mode=OneWay}" Value="{Binding Value, Mode=OneWay}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding RevenueText}" Foreground="#CBD5E1" FontSize="14" FontWeight="SemiBold"
                                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Recent transactions -->
                        <Border Background="#801E293B" BorderBrush="#80334155" BorderThickness="1" CornerRadius="16">
                            <StackPanel>
                                <Grid Margin="24,20" >
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <Path Data="M8 4 H16 V6 H8 Z M6 5 H8 M16 5 H18 V21 H6 V5 H8 M9 11 H15 M9 15 H15" Stroke="#3B82F6" StrokeThickness="1.6" Fill="Transparent" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center"/>
                                        <TextBlock Text="RECENT TRANSACTIONS" Foreground="White" FontSize="14" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Border Background="#80334155" CornerRadius="999" Padding="10,3" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding TransactionCountText}" Foreground="#64748B" FontSize="12"/>
                                    </Border>
                                </Grid>
                                <Border Height="1" Background="#80334155"/>

                                <!-- header -->
                                <Grid Margin="24,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.6*"/>
                                        <ColumnDefinition Width="1.3*"/>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="1.6*"/>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="1.4*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="0.8*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="DATE" Foreground="#64748B" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="REFERENCE" Foreground="#64748B" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="2" Text="CUSTOMER" Foreground="#64748B" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="3" Text="MOVIE" Foreground="#64748B" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="4" Text="CINEMA" Foreground="#64748B" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="5" Text="SEATS" Foreground="#64748B" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="6" Text="AMOUNT" Foreground="#64748B" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="7" Text="STATUS" Foreground="#64748B" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                </Grid>
                                <Border Height="1" Background="#4D334155"/>

                                <!-- empty -->
                                <TextBlock Text="No paid transactions yet." Foreground="#64748B" HorizontalAlignment="Center" Margin="0,48"
                                           Visibility="{Binding ReportEmpty, Converter={StaticResource BoolToVisibility}}"/>

                                <!-- rows -->
                                <ItemsControl ItemsSource="{Binding TransactionRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#33334155" BorderThickness="0,0,0,1" Padding="24,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.6*"/>
                                                        <ColumnDefinition Width="1.3*"/>
                                                        <ColumnDefinition Width="1.2*"/>
                                                        <ColumnDefinition Width="1.6*"/>
                                                        <ColumnDefinition Width="1.5*"/>
                                                        <ColumnDefinition Width="1.4*"/>
                                                        <ColumnDefinition Width="1*"/>
                                                        <ColumnDefinition Width="0.8*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding DateText}" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>
                                                    <Border Grid.Column="1" Background="#80334155" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Reference}" Foreground="#CBD5E1" FontFamily="Consolas" FontSize="12"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="2" Text="{Binding Customer}" Foreground="#CBD5E1" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding Movie}" Foreground="#CBD5E1" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="4" Text="{Binding Cinema}" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <ItemsControl ItemsSource="{Binding SeatsShown}">
                                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Background="#1A3B82F6" BorderBrush="#333B82F6" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="0,0,4,0">
                                                                        <TextBlock Text="{Binding}" Foreground="#60A5FA" FontSize="11"/>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <TextBlock Text="{Binding SeatsMore}" Foreground="#64748B" FontSize="11" VerticalAlignment="Center"
                                                                   Visibility="{Binding HasMoreSeats, Converter={StaticResource BoolToVisibility}}"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="6" Text="{Binding AmountText}" Foreground="#34D399" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                    <Border Grid.Column="7" Background="#1A10B981" BorderBrush="#3310B981" BorderThickness="1" CornerRadius="999" Padding="8,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Status}" Foreground="#34D399" FontSize="11"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ═══════════ LOG ACTIVITIES SECTION ═══════════ -->
                    <StackPanel Visibility="{Binding IsActivitySection, Converter={StaticResource BoolToVisibility}}">

                        <!-- Header -->
                        <Grid Margin="0,0,0,24">
                            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="Log Activities" FontSize="24" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="Who logged in and who bought tickets" Foreground="#64748B" FontSize="14" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button HorizontalAlignment="Right" VerticalAlignment="Center" Command="{Binding RefreshActivityCommand}"
                                    Cursor="Hand" Foreground="White" FontWeight="SemiBold">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="#2563EB" CornerRadius="10" Padding="18,10">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="M20 11 A8 8 0 1 0 18 16 M20 5 V11 H14" Stroke="White" StrokeThickness="2" Fill="Transparent" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                                                <TextBlock Text="Refresh" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#3B82F6"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- Activity table -->
                        <Border Background="#801E293B" BorderBrush="#80334155" BorderThickness="1" CornerRadius="16">
                            <StackPanel>
                                <Grid Margin="24,20">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <Path Data="M12 21 A9 9 0 1 0 12 3 A9 9 0 1 0 12 21 M12 7 V12 L15.5 14" Stroke="#C084FC" StrokeThickness="1.6" Fill="Transparent" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center"/>
                                        <TextBlock Text="ACTIVITY LOG" Foreground="White" FontSize="14" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Border Background="#80334155" CornerRadius="999" Padding="10,3" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding ActivityCountText}" Foreground="#64748B" FontSize="12"/>
                                    </Border>
                                </Grid>
                                <Border Height="1" Background="#80334155"/>

                                <!-- header -->
                                <Grid Margin="24,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1.4*"/>
                                        <ColumnDefinition Width="0.9*"/>
                                        <ColumnDefinition Width="2.2*"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="TIME" Foreground="#64748B" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="USER" Foreground="#64748B" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="2" Text="EMAIL" Foreground="#64748B" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="3" Text="ACTIVITY" Foreground="#64748B" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="DETAIL" Foreground="#64748B" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="5" Text="REFERENCE" Foreground="#64748B" FontSize="11" FontWeight="SemiBold"/>
                                </Grid>
                                <Border Height="1" Background="#4D334155"/>

                                <!-- empty -->
                                <StackPanel Margin="0,48" HorizontalAlignment="Center"
                                            Visibility="{Binding ActivityEmpty, Converter={StaticResource BoolToVisibility}}">
                                    <Path Data="M12 21 A9 9 0 1 0 12 3 A9 9 0 1 0 12 21 M12 7 V12 L15.5 14"
                                          Stroke="#334155" StrokeThickness="1.5" Fill="Transparent" Width="48" Height="48" Stretch="Uniform" HorizontalAlignment="Center"/>
                                    <TextBlock Text="No activity yet" Foreground="#64748B" FontWeight="Medium" HorizontalAlignment="Center" Margin="0,16,0,4"/>
                                    <TextBlock Text="Run UntukDatabase.sql once, then login or buy a ticket." Foreground="#475569" FontSize="12" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <!-- rows -->
                                <ItemsControl ItemsSource="{Binding ActivityRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#33334155" BorderThickness="0,0,0,1" Padding="24,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.2*"/>
                                                        <ColumnDefinition Width="1*"/>
                                                        <ColumnDefinition Width="1.4*"/>
                                                        <ColumnDefinition Width="0.9*"/>
                                                        <ColumnDefinition Width="2.2*"/>
                                                        <ColumnDefinition Width="1*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding TimeText}" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding User}" Foreground="#CBD5E1" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Email}" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                                    <Border Grid.Column="3" Background="{Binding BadgeBackground}" CornerRadius="999" Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding TypeUpper}" Foreground="{Binding BadgeForeground}" FontSize="11" FontWeight="SemiBold"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="4" Text="{Binding Detail}" Foreground="#CBD5E1" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
                                                    <Border Grid.Column="5" Background="#80334155" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                            Visibility="{Binding HasReference, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="{Binding Reference}" Foreground="#CBD5E1" FontFamily="Consolas" FontSize="12"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- Loading overlay -->
            <Border Grid.Row="1" Background="#66000000" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                <ProgressBar IsIndeterminate="True" Width="220" Height="3" Background="Transparent" Foreground="#2563EB"
                             BorderThickness="0" VerticalAlignment="Center"/>
            </Border>

            <!-- PDF Preview Overlay -->
            <Border Grid.Row="0" Grid.RowSpan="2" Background="#E60A0B14"
                    Visibility="{Binding IsPreviewVisible, Converter={StaticResource BoolToVisibility}}">
                <Grid Margin="32">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Path Data="M7 3 H14 L19 8 V21 H7 Z M14 3 V8 H19 M9 13 H15 M9 16 H15"
                                  Stroke="#60A5FA" StrokeThickness="1.6" Fill="Transparent" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center"/>
                            <TextBlock Text="PDF Preview" Foreground="White" FontSize="20" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding PreviewPageText}" Foreground="#64748B" FontSize="14" Margin="16,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Command="{Binding ClosePreviewCommand}" HorizontalAlignment="Right" Cursor="Hand" VerticalAlignment="Center">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="#801E293B" BorderBrush="#80334155" BorderThickness="1" CornerRadius="8" Padding="14,8">
                                        <TextBlock Text="✕  Close" Foreground="#94A3B8" FontSize="13"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#1E293B"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <!-- Page Image -->
                    <Border Grid.Row="1" Background="#801E293B" BorderBrush="#66334155" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="Transparent">
                            <Image Source="{Binding CurrentPreviewPage}" Stretch="Uniform" Margin="16"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </ScrollViewer>
                    </Border>

                    <!-- Bottom Bar: Nav + Export -->
                    <Grid Grid.Row="2" Margin="0,16,0,0">
                        <!-- Page navigation -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button Command="{Binding PrevPageCommand}" Cursor="Hand" Margin="0,0,12,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="#801E293B" BorderBrush="#80334155" BorderThickness="1" CornerRadius="8" Padding="14,8">
                                            <TextBlock Text="◀  Prev" Foreground="#94A3B8" FontSize="12"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#1E293B"/></Trigger>
                                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.3"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <TextBlock Text="{Binding PreviewPageText}" Foreground="#CBD5E1" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button Command="{Binding NextPageCommand}" Cursor="Hand" Margin="12,0,0,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="#801E293B" BorderBrush="#80334155" BorderThickness="1" CornerRadius="8" Padding="14,8">
                                            <TextBlock Text="Next  ▶" Foreground="#94A3B8" FontSize="12"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#1E293B"/></Trigger>
                                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.3"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>

                        <!-- Export PDF button -->
                        <Button HorizontalAlignment="Right" VerticalAlignment="Center" Click="ExportPdf_Click" Cursor="Hand" Foreground="White" FontWeight="SemiBold">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" CornerRadius="10" Padding="20,10">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#2563EB" Offset="0"/>
                                                <GradientStop Color="#9333EA" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M7 3 H14 L19 8 V21 H7 Z M14 3 V8 H19 M9 13 H15 M9 16 H15"
                                                  Stroke="White" StrokeThickness="1.6" Fill="Transparent" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                                            <TextBlock Text="Export PDF" Margin="8,0,0,0" FontSize="13" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.85"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
