<UserControl x:Class="CineCore.Views.AdminPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0A0B14" Foreground="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0D0F1E" BorderBrush="#1E2030" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Button Content="← Back" Style="{StaticResource SecondaryButton}"
                        Command="{Binding GoBackCommand}"
                        Height="34" Padding="16,0" FontSize="13"
                        HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <TextBlock Text="Admin Panel" Foreground="#F0F2FF"
                           FontSize="15" FontWeight="SemiBold" FontFamily="Segoe UI"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="24,12"
                    SelectedIndex="{Binding SelectedTab}">

            <!-- ═══ TAB: MOVIES ═══ -->
            <TabItem Header="Movies" Foreground="#F0F2FF" Background="#12141F">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Movie List -->
                    <Border Background="#12141F" CornerRadius="8" Padding="12" BorderBrush="#1E2030" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="All Movies" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/>
                            <ListBox ItemsSource="{Binding Movies}" SelectedItem="{Binding SelectedMovie}"
                                     Background="Transparent" BorderThickness="0" MaxHeight="500"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="4">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#F0F2FF"/>
                                            <TextBlock Foreground="#5A6080" FontSize="11">
                                                <Run Text="{Binding Genre}"/>
                                                <Run Text=" · "/>
                                                <Run Text="{Binding DurationMinutes, StringFormat={}{0} min}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="Padding" Value="6"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#1A007AFF"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <!-- Movie Form -->
                    <Border Grid.Column="1" Background="#12141F" CornerRadius="8" Padding="20" Margin="16,0,0,0"
                            BorderBrush="#1E2030" BorderThickness="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Movie Details" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,16"/>

                                <TextBlock Text="TITLE" Style="{StaticResource LabelText}"/>
                                <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                                <TextBlock Text="GENRE" Style="{StaticResource LabelText}"/>
                                <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding EditGenre, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="DURATION (min)" Style="{StaticResource LabelText}"/>
                                        <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding EditDuration, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="RELEASE DATE" Style="{StaticResource LabelText}"/>
                                        <DatePicker SelectedDate="{Binding EditReleaseDate}" Background="#1A1C2A" Foreground="White" BorderBrush="#252736" Height="44"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="POSTER URL" Style="{StaticResource LabelText}"/>
                                <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding EditPosterUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                                <TextBlock Text="TRAILER URL" Style="{StaticResource LabelText}"/>
                                <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding EditTrailerUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                                <CheckBox Content="Now Showing" IsChecked="{Binding EditIsShowing}" Foreground="#F0F2FF" Margin="0,0,0,16"/>

                                <!-- Action Buttons -->
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Content="Add New" Style="{StaticResource PrimaryButton}" Height="38" Padding="20,0" Margin="0,0,8,0"
                                            Command="{Binding AddNewMovieCommand}"/>
                                    <Button Content="Save Changes" Style="{StaticResource SecondaryButton}" Height="38" Padding="20,0" Margin="0,0,8,0"
                                            Command="{Binding SaveMovieCommand}"/>
                                    <Button Content="Delete" Height="38" Padding="20,0" Margin="0,0,8,0" Cursor="Hand"
                                            Command="{Binding DeleteMovieCommand}" Background="#EF4444" Foreground="White" BorderThickness="0">
                                        <Button.Resources>
                                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                                        </Button.Resources>
                                    </Button>
                                    <Button Content="Clear" Style="{StaticResource SecondaryButton}" Height="38" Padding="20,0"
                                            Command="{Binding ClearMovieFormCommand}"/>
                                </WrapPanel>

                                <!-- Status -->
                                <TextBlock Text="{Binding StatusMessage}" Foreground="#3B82F6" FontSize="13" Margin="0,12,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ═══ TAB: SHOWTIMES ═══ -->
            <TabItem Header="Showtimes" Foreground="#F0F2FF" Background="#12141F">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Add Showtime Form -->
                    <Border Background="#12141F" CornerRadius="8" Padding="20" BorderBrush="#1E2030" BorderThickness="1" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Add New Showtime" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,16"/>
                            <WrapPanel>
                                <StackPanel Margin="0,0,16,8" Width="200">
                                    <TextBlock Text="MOVIE" Style="{StaticResource LabelText}"/>
                                    <ComboBox ItemsSource="{Binding Movies}" SelectedItem="{Binding ShowtimeMovie}"
                                              DisplayMemberPath="Title" Style="{StaticResource DarkComboBox}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,16,8" Width="180">
                                    <TextBlock Text="CINEMA" Style="{StaticResource LabelText}"/>
                                    <ComboBox ItemsSource="{Binding Cinemas}" SelectedItem="{Binding ShowtimeCinema}"
                                              DisplayMemberPath="Name" Style="{StaticResource DarkComboBox}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,16,8" Width="160">
                                    <TextBlock Text="DATE" Style="{StaticResource LabelText}"/>
                                    <DatePicker SelectedDate="{Binding ShowtimeDate}" Background="#1A1C2A" Foreground="White" BorderBrush="#252736" Height="44"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,16,8" Width="100">
                                    <TextBlock Text="TIME (HH:mm)" Style="{StaticResource LabelText}"/>
                                    <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding ShowtimeTime, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,16,8" Width="120">
                                    <TextBlock Text="PRICE (Rp)" Style="{StaticResource LabelText}"/>
                                    <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding ShowtimePrice, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,8">
                                    <Button Content="Add Showtime" Style="{StaticResource PrimaryButton}" Height="44" Padding="20,0"
                                            Command="{Binding AddShowtimeCommand}"/>
                                </StackPanel>
                            </WrapPanel>
                            <TextBlock Text="{Binding StatusMessage}" Foreground="#3B82F6" FontSize="13" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Showtime List -->
                    <Border Grid.Row="1" Background="#12141F" CornerRadius="8" Padding="16" BorderBrush="#1E2030" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="All Showtimes" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="400">
                                <ItemsControl ItemsSource="{Binding Showtimes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#0D0F1E" CornerRadius="6" Padding="12" Margin="0,0,0,6">
                                                <Grid>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding MovieTitle}" FontWeight="SemiBold" Foreground="#F0F2FF" Width="200" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding CinemaName}" Foreground="#8B8FA8" Width="120" Margin="12,0"/>
                                                        <TextBlock Foreground="#5A6080" Width="100">
                                                            <Run Text="{Binding ShowDate, StringFormat={}{0:dd MMM}}"/>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding TimeFormatted}" Foreground="#F0F2FF" Width="60"/>
                                                        <TextBlock Text="{Binding PricePerSeat, StringFormat=Rp {0:N0}}" Foreground="#3B82F6" Width="100"/>
                                                    </StackPanel>
                                                    <Button Content="✕" HorizontalAlignment="Right" Background="Transparent"
                                                            Foreground="#EF4444" BorderThickness="0" Cursor="Hand" FontSize="14"
                                                            Command="{Binding DataContext.DeleteShowtimeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Loading -->
        <Border Grid.Row="1" Background="#99000000" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <ProgressBar IsIndeterminate="True" Width="200" Height="3" Background="Transparent" Foreground="#007AFF" BorderThickness="0" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
