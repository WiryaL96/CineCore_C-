<UserControl x:Class="CineCore.Views.PaymentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CineCore.Converters"
             Background="#0A0B14" Foreground="White">

    <UserControl.Resources>
        <conv:StringEqualityConverter x:Key="StringEquality"/>
        <Style TargetType="RadioButton" x:Key="PaymentCardStyle">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="#1F2937" BorderBrush="#374151" BorderThickness="1" CornerRadius="8" Padding="15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{TemplateBinding Content}" FontSize="15" Foreground="White" VerticalAlignment="Center"/>

                                <Border Grid.Column="1" Width="20" Height="20" CornerRadius="10" BorderBrush="#4B5563" BorderThickness="2" x:Name="CheckRing" Background="Transparent">
                                    <Ellipse Fill="#3B82F6" Width="10" Height="10" Visibility="Collapsed" x:Name="CheckDot"/>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckDot" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="CheckRing" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#273345"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,30">
            <Button Command="{Binding GoBackCommand}" Content="← Back to Seats" Background="Transparent" Foreground="#3B82F6" BorderThickness="0" HorizontalAlignment="Left" FontSize="14" FontWeight="SemiBold" Cursor="Hand"/>
            <TextBlock Text="Checkout &amp; Payment" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,40,0">
                <TextBlock Text="Select Payment Method" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,20"/>

                <TextBlock Text="E-Wallet" Foreground="#9CA3AF" FontSize="13" Margin="0,0,0,10"/>
                <RadioButton Content="GoPay" Style="{StaticResource PaymentCardStyle}"
                             IsChecked="{Binding SelectedPaymentMethod, Converter={StaticResource StringEquality}, ConverterParameter=GoPay}"/>
                <RadioButton Content="OVO" Style="{StaticResource PaymentCardStyle}"
                             IsChecked="{Binding SelectedPaymentMethod, Converter={StaticResource StringEquality}, ConverterParameter=OVO}"/>
                <RadioButton Content="DANA" Style="{StaticResource PaymentCardStyle}" Margin="0,0,0,25"
                             IsChecked="{Binding SelectedPaymentMethod, Converter={StaticResource StringEquality}, ConverterParameter=DANA}"/>

                <TextBlock Text="Virtual Account" Foreground="#9CA3AF" FontSize="13" Margin="0,0,0,10"/>
                <RadioButton Content="BCA Virtual Account" Style="{StaticResource PaymentCardStyle}"
                             IsChecked="{Binding SelectedPaymentMethod, Converter={StaticResource StringEquality}, ConverterParameter=BCA Virtual Account}"/>
                <RadioButton Content="Mandiri Virtual Account" Style="{StaticResource PaymentCardStyle}"
                             IsChecked="{Binding SelectedPaymentMethod, Converter={StaticResource StringEquality}, ConverterParameter=Mandiri Virtual Account}"/>
            </StackPanel>

            <Border Grid.Column="1" Background="#111827" CornerRadius="12" Padding="25" VerticalAlignment="Top" BorderBrush="#1F2937" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Booking Summary" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,20"/>

                    <TextBlock Text="{Binding Movie.Title}" FontSize="20" FontWeight="Bold" Margin="0,0,0,5" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Cinema.Name}" Foreground="#9CA3AF" FontSize="14" Margin="0,0,0,15"/>

                    <Separator Background="#374151" Margin="0,0,0,15"/>

                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="Date" Foreground="#9CA3AF"/>
                        <TextBlock Text="{Binding Showtime.ShowDate, StringFormat={}{0:dd MMM yyyy}}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                    </Grid>
                    <Grid Margin="0,0,0,15">
                        <TextBlock Text="Time" Foreground="#9CA3AF"/>
                        <TextBlock Text="{Binding Showtime.TimeFormatted, Mode=OneWay}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                    </Grid>

                    <Separator Background="#374151" Margin="0,0,0,15"/>

                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="Selected Seats" Foreground="#9CA3AF"/>
                        <TextBlock Text="{Binding SelectedSeatsText}" HorizontalAlignment="Right" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="200" TextAlignment="Right"/>
                    </Grid>

                    <Separator Background="#374151" Margin="0,0,0,15"/>

                    <Grid Margin="0,0,0,30">
                        <TextBlock Text="Total Payment" FontSize="16" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding TotalPrice, StringFormat=Rp {0:N0}}" FontSize="22" FontWeight="Bold" Foreground="#3B82F6" HorizontalAlignment="Right"/>
                    </Grid>

                    <Button Content="Confirm Payment" Command="{Binding ProcessPaymentCommand}" Background="#3B82F6" Foreground="White" Height="50" FontSize="16" FontWeight="Bold" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>