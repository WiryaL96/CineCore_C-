<UserControl x:Class="CineCore.Views.BookingHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#020617" Foreground="White" FontFamily="Segoe UI">

    <UserControl.Resources>
        <!-- Tombol aksi kartu (View Ticket / Pay Now) -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Kartu booking (hover border) -->
        <Style x:Key="BookingCard" TargetType="Border">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#1E293B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#334155"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1024" HorizontalAlignment="Center" Margin="32">

            <!-- Back link -->
            <Button Command="{Binding GoBackCommand}" Content="← Back"
                    Background="Transparent" Foreground="#3B82F6" BorderThickness="0"
                    HorizontalAlignment="Left" FontSize="14" FontWeight="SemiBold"
                    Cursor="Hand" Margin="0,0,0,16"/>

            <!-- ══════════ HEADER ══════════ -->
            <StackPanel Margin="0,0,0,32">
                <StackPanel Orientation="Horizontal">
                    <Path Data="M4 7 H20 V17 H4 Z M12 7 V9 M12 11 V13 M12 15 V17"
                          Stroke="#3B82F6" StrokeThickness="2" Fill="Transparent"
                          Width="28" Height="28" Stretch="Uniform" VerticalAlignment="Center"/>
                    <TextBlock Text="My Tickets" FontSize="30" FontWeight="Bold" Foreground="White"
                               Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Your booking history and e-tickets" Foreground="#94A3B8"
                           FontSize="14" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- ══════════ EMPTY STATE ══════════ -->
            <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="16"
                    Padding="48" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <StackPanel HorizontalAlignment="Center">
                    <Path Data="M4 7 H20 V17 H4 Z M12 7 V9 M12 11 V13 M12 15 V17"
                          Stroke="#334155" StrokeThickness="1.5" Fill="Transparent"
                          Width="64" Height="64" Stretch="Uniform" HorizontalAlignment="Center"/>
                    <TextBlock Text="No tickets yet" Foreground="White" FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,20,0,8"/>
                    <TextBlock Text="Browse movies and book your first ticket!" Foreground="#64748B"
                               FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,24"/>
                    <Button Style="{StaticResource ActionBtn}" Background="#2563EB" Content="Browse Movies"
                            Padding="24,10" FontSize="14" HorizontalAlignment="Center"
                            Command="{Binding BrowseMoviesCommand}"/>
                </StackPanel>
            </Border>

            <!-- ══════════ BOOKING LIST ══════════ -->
            <ItemsControl ItemsSource="{Binding Tickets}"
                          Visibility="{Binding HasTickets, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource BookingCard}">
                            <!-- ClipToBounds biar poster ngikut sudut membulat kartu -->
                            <Grid ClipToBounds="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="112"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Poster thumbnail -->
                                <Grid Grid.Column="0" MinHeight="128">
                                    <Border Background="#111827"/>
                                    <Image Source="{Binding PosterUrl, Converter={StaticResource PosterUrl}}"
                                           Stretch="UniformToFill"/>
                                </Grid>

                                <!-- Info + action -->
                                <Grid Grid.Column="1" Margin="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left info -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold"
                                                       Foreground="White" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Border Background="{Binding StatusBg}" BorderBrush="{Binding StatusBorder}"
                                                    BorderThickness="1" CornerRadius="999" Padding="8,2"
                                                    Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StatusLabel}" Foreground="{Binding StatusFg}"
                                                           FontSize="12" FontWeight="Medium"/>
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <TextBlock Text="{Binding Reference}" FontFamily="Consolas"
                                                       Foreground="#94A3B8" FontSize="12"/>
                                            <TextBlock Text="   •   " Foreground="#475569" FontSize="12"/>
                                            <TextBlock Text="{Binding CinemaName}" Foreground="#94A3B8" FontSize="12"/>
                                            <TextBlock Text="   •   " Foreground="#475569" FontSize="12"/>
                                            <TextBlock Text="{Binding ShowtimeText}" Foreground="#94A3B8" FontSize="12"/>
                                        </StackPanel>

                                        <ItemsControl ItemsSource="{Binding Seats}" Margin="0,10,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1"
                                                            CornerRadius="4" Padding="8,2" Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding}" Foreground="#94A3B8" FontSize="12"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- Right: total + action button -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                                HorizontalAlignment="Right" Margin="16,0,0,0">
                                        <TextBlock Text="{Binding TotalFormatted}" Foreground="#60A5FA"
                                                   FontSize="14" FontWeight="Bold" HorizontalAlignment="Right"/>
                                        <Button Style="{StaticResource ActionBtn}" Background="#2563EB"
                                                Content="View Ticket" Margin="0,10,0,0"
                                                Visibility="{Binding IsPaid, Converter={StaticResource BoolToVisibility}}"
                                                Command="{Binding DataContext.OpenBookingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Style="{StaticResource ActionBtn}" Background="#CA8A04"
                                                Content="Pay Now" Margin="0,10,0,0"
                                                Visibility="{Binding IsPending, Converter={StaticResource BoolToVisibility}}"
                                                Command="{Binding DataContext.OpenBookingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Loading -->
            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,16,0,0" Background="Transparent"
                         Foreground="#2563EB" BorderThickness="0"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
