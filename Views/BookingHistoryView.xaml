<UserControl x:Class="CineCore.Views.BookingHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0A0B14" Foreground="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0D0F1E" BorderBrush="#1E2030" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Button Content="← Back" Style="{StaticResource SecondaryButton}"
                        Command="{Binding GoBackCommand}"
                        Height="34" Padding="16,0" FontSize="13"
                        HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <TextBlock Text="My Bookings" Foreground="#F0F2FF"
                           FontSize="15" FontWeight="SemiBold" FontFamily="Segoe UI"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Empty state -->
        <TextBlock Grid.Row="1" Text="Belum ada booking. Yuk pesan tiket pertamamu!"
                   Foreground="#5A6080" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"/>

        <!-- Booking List -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Bookings}" Margin="32,20">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#12141F" CornerRadius="12" Padding="20" Margin="0,0,0,16"
                                BorderBrush="#1E2030" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Poster -->
                                <Border CornerRadius="6" ClipToBounds="True" Width="50" Height="70">
                                    <Image Source="{Binding Movie.PosterUrl, Converter={StaticResource PosterUrl}}" Stretch="UniformToFill"/>
                                </Border>

                                <!-- Info -->
                                <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Movie.Title}" FontSize="16" FontWeight="Bold"
                                               Foreground="#F0F2FF" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Foreground="#8B8FA8" FontSize="12" Margin="0,4,0,0">
                                        <Run Text="{Binding Showtime.CinemaName}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding Showtime.ShowDate, StringFormat={}{0:dd MMM yyyy}}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding Showtime.TimeFormatted, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Foreground="#5A6080" FontSize="12" Margin="0,2,0,0">
                                        <Run Text="Seats: "/>
                                        <Run Text="{Binding SeatsDisplay, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Foreground="#5A6080" FontSize="11" Margin="0,2,0,0">
                                        <Run Text="Code: "/>
                                        <Run Text="{Binding BookingCode}" FontFamily="Consolas" Foreground="#3B82F6"/>
                                    </TextBlock>
                                </StackPanel>

                                <!-- Price & Status -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding TotalAmount, StringFormat=Rp {0:N0}}" 
                                               FontSize="16" FontWeight="Bold" Foreground="#3B82F6" HorizontalAlignment="Right"/>
                                    <Border Background="#1A3B82F6" CornerRadius="4" Padding="8,3" Margin="0,6,0,0" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding Status}" Foreground="#3B82F6" FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                    <TextBlock Text="{Binding PaymentMethod}" Foreground="#5A6080" FontSize="11" 
                                               HorizontalAlignment="Right" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Loading -->
        <Border Grid.Row="1" Background="#99000000" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <ProgressBar IsIndeterminate="True" Width="200" Height="3" Background="Transparent" Foreground="#007AFF" BorderThickness="0" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
