<UserControl x:Class="CineCore.Views.SeatSelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0A0B14">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0D0F1E" BorderBrush="#1E2030" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Button Content="← Back" Style="{StaticResource SecondaryButton}"
                        Command="{Binding GoBackCommand}"
                        Height="34" Padding="16,0" FontSize="13"
                        HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <TextBlock Text="Select Your Seats" Foreground="#F0F2FF"
                           FontSize="15" FontWeight="SemiBold" FontFamily="Segoe UI"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="32,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" HorizontalAlignment="Center">

                    <Border Background="#1A2235" CornerRadius="0,0,40,40"
                            Height="12" Width="420" Margin="0,0,0,8">
                        <Border.Effect>
                            <DropShadowEffect ShadowDepth="0" BlurRadius="20" Color="#007AFF" Opacity="0.5"/>
                        </Border.Effect>
                    </Border>
                    <TextBlock Text="S C R E E N" Foreground="#3A4060"
                               FontSize="11" FontFamily="Segoe UI" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,6,0,32"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="30,0,0,8">
                        <ItemsControl>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <TextBlock Text=" 1" Width="48" TextAlignment="Center" Foreground="#3A4060" FontSize="11"/>
                            <TextBlock Text=" 2" Width="48" TextAlignment="Center" Foreground="#3A4060" FontSize="11"/>
                            <TextBlock Text=" 3" Width="48" TextAlignment="Center" Foreground="#3A4060" FontSize="11"/>
                            <TextBlock Text=" 4" Width="48" TextAlignment="Center" Foreground="#3A4060" FontSize="11"/>
                            <TextBlock Text=" 5" Width="48" TextAlignment="Center" Foreground="#3A4060" FontSize="11"/>
                            <TextBlock Text=" 6" Width="48" TextAlignment="Center" Foreground="#3A4060" FontSize="11"/>
                            <TextBlock Text=" 7" Width="48" TextAlignment="Center" Foreground="#3A4060" FontSize="11"/>
                            <TextBlock Text=" 8" Width="48" TextAlignment="Center" Foreground="#3A4060" FontSize="11"/>
                        </ItemsControl>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Seats}" Margin="0,0,0,20">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="5" Columns="8"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.ToggleSeatCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Width="42" Height="42" Margin="6" Cursor="Hand" ToolTip="{Binding Label}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bd" Background="#2A2A3E" CornerRadius="8">
                                                            <TextBlock x:Name="txt" Text="{Binding Label}" Foreground="#5A6080" 
                                                                       FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding State, StringFormat={}{0}}" Value="Selected">
                                                                <Setter TargetName="bd" Property="Background" Value="#007AFF"/>
                                                                <Setter TargetName="txt" Property="Foreground" Value="White"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding State, StringFormat={}{0}}" Value="Booked">
                                                                <Setter TargetName="bd" Property="Background" Value="#4A1A1A"/>
                                                                <Setter TargetName="bd" Property="Opacity" Value="0.6"/>
                                                                <Setter TargetName="txt" Property="Foreground" Value="#5A6080"/>
                                                            </DataTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State, StringFormat={}{0}}" Value="Booked">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,28,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                            <Border Width="18" Height="18" CornerRadius="4" Background="#2A2A3E" Margin="0,0,8,0"/>
                            <TextBlock Text="Available" Foreground="#8B8FA8" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                            <Border Width="18" Height="18" CornerRadius="4" Background="#007AFF" Margin="0,0,8,0"/>
                            <TextBlock Text="Selected" Foreground="#8B8FA8" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="18" Height="18" CornerRadius="4" Background="#4A1A1A" Margin="0,0,8,0"/>
                            <TextBlock Text="Booked" Foreground="#8B8FA8" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1" Background="#12141F" BorderBrush="#1E2030" BorderThickness="1"
                        CornerRadius="14" Padding="24" VerticalAlignment="Top" Margin="24,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Booking Summary" Foreground="#F0F2FF" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,20"/>

                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="{Binding Movie.Title}" Foreground="#F0F2FF" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Cinema.Name}" Foreground="#5A6080" FontSize="13" Margin="0,4,0,0"/>
                            <TextBlock Foreground="#5A6080" FontSize="13" Margin="0,2,0,0">
                                <Run Text="{Binding Showtime.ShowDate, StringFormat='{}{0:dd MMM yyyy}'}"/>
                                <Run Text=" · "/>
                                <Run Text="{Binding Showtime.TimeFormatted, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>

                        <Separator Background="#1E2030" Margin="0,0,0,16"/>

                        <TextBlock Text="SELECTED SEATS" Style="{StaticResource LabelText}" Margin="0,0,0,8"/>
                        <Border Background="#0D0F1E" CornerRadius="8" Padding="12" MinHeight="48">
                            <TextBlock Text="{Binding SelectedSeatsText}" Foreground="#F0F2FF" FontSize="14" TextWrapping="Wrap"/>
                        </Border>

                        <Separator Background="#1E2030" Margin="0,16"/>

                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="Price / seat" Foreground="#5A6080" FontSize="13"/>
                            <TextBlock Text="{Binding Showtime.PricePerSeat, StringFormat='Rp {0:N0}'}" Foreground="#F0F2FF" FontSize="13" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="Seats" Foreground="#5A6080" FontSize="13"/>
                            <TextBlock Text="{Binding SelectedSeatLabels.Count}" Foreground="#F0F2FF" FontSize="13" HorizontalAlignment="Right"/>
                        </Grid>

                        <Separator Background="#1E2030" Margin="0,10"/>

                        <Grid>
                            <TextBlock Text="Total" Foreground="#F0F2FF" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalPriceText}" Foreground="#007AFF" FontSize="18" FontWeight="Bold" HorizontalAlignment="Right"/>
                        </Grid>

                        <Button Content="Continue to Payment  →" Style="{StaticResource PrimaryButton}"
                                Command="{Binding ContinueCommand}" Height="44" Margin="0,20,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="1" Background="#99000000" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <ProgressBar IsIndeterminate="True" Width="200" Height="3" Background="Transparent" Foreground="#007AFF" BorderThickness="0" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>