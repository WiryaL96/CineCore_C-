<UserControl x:Class="CineCore.Views.MovieDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0B0F19" Foreground="White">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Button Grid.Row="0" Command="{Binding GoBackCommand}" Content="← Back to Movies" Background="Transparent" Foreground="#3B82F6" BorderThickness="0" HorizontalAlignment="Left" FontSize="14" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,0,20"/>

            <Border Grid.Row="1" Background="#111827" CornerRadius="12" Padding="20" Margin="0,0,0,40">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border CornerRadius="8" ClipToBounds="True" Width="180" Height="250" Margin="0,0,30,0">
                        <Grid>
                            <Border Background="#1A1C2A">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="🎬" FontSize="36" HorizontalAlignment="Center" Opacity="0.5"/>
                                    <TextBlock Text="No Poster" Foreground="#5A6080" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                            <Image Source="{Binding Movie.PosterUrl, Converter={StaticResource PosterUrl}}" Stretch="UniformToFill"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Movie.Title}" FontSize="32" FontWeight="Bold" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <TextBlock Text="{Binding Movie.Genre}" Foreground="#9CA3AF" FontSize="14"/>
                            <TextBlock Text="  •  " Foreground="#4B5563" FontSize="14"/>
                            <TextBlock Text="{Binding Movie.DurationMinutes, StringFormat={}{0} min}" Foreground="#9CA3AF" FontSize="14"/>
                            <TextBlock Text="  •  " Foreground="#4B5563" FontSize="14"/>
                            <TextBlock Text="2D" Foreground="#3B82F6" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                        <Button Command="{Binding WatchTrailerCommand}" Content="▶ Watch Trailer" Background="#3B82F6" Foreground="White" BorderThickness="0" Width="140" Height="40" HorizontalAlignment="Left" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Row="2" Margin="0,0,0,30">
                <TextBlock Text="Select Date" FontSize="16" FontWeight="SemiBold" Foreground="#9CA3AF" Margin="0,0,0,15"/>
                <ListBox ItemsSource="{Binding AvailableDates}" SelectedItem="{Binding SelectedDate}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,5">
                                <TextBlock Text="{Binding StringFormat={}{0:ddd}}" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding StringFormat={}{0:dd}}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding StringFormat={}{0:MMM}}" FontSize="12" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="Foreground" Value="Black"/>
                            <Setter Property="Margin" Value="0,0,10,0"/>
                            <Setter Property="Padding" Value="15,10"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#3B82F6"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </StackPanel>

            <StackPanel Grid.Row="3" Margin="0,0,0,20">
                <TextBlock Text="Select Cinema" FontSize="16" FontWeight="SemiBold" Foreground="#9CA3AF" Margin="0,0,0,15"/>
                <ListBox ItemsSource="{Binding Cinemas}" SelectedItem="{Binding SelectedCinema}" Background="Transparent" BorderThickness="0">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="Foreground" Value="Black"/>
                            <Setter Property="Margin" Value="0,0,10,10"/>
                            <Setter Property="Padding" Value="20,10"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#3B82F6"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </StackPanel>

            <Border Grid.Row="4" Background="White" CornerRadius="8" Padding="25">
                <StackPanel>
                    <TextBlock Text="Available Showtimes" FontSize="14" FontWeight="SemiBold" Foreground="#4B5563" Margin="0,0,0,15"/>

                    <TextBlock Text="Oops! Jadwal kosong / Film udah turun layar bang." Foreground="#EF4444" Margin="0,10,0,20" FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Showtimes.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ListBox ItemsSource="{Binding Showtimes}" SelectedItem="{Binding SelectedShowtime}" Background="Transparent" BorderThickness="0" Margin="0,0,0,20">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TimeFormatted}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="#F3F4F6"/>
                                <Setter Property="Foreground" Value="#4B5563"/>
                                <Setter Property="Margin" Value="0,0,10,10"/>
                                <Setter Property="Width" Value="100"/>
                                <Setter Property="Padding" Value="0,12"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#3B82F6"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <Button Content="Select Seats" Command="{Binding SelectSeatsCommand}" Background="#3B82F6" Foreground="White" Height="45" FontSize="16" FontWeight="Bold" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Border>

        </Grid>
    </ScrollViewer>
</UserControl>